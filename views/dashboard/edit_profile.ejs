<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile - Alpha Dashboard</title>
    <link rel="stylesheet" href="/css/edit_profile.css">
    <link rel="stylesheet" href="/css/sidebar.css">
</head>

<body>
   

    <nav class="navbar">
        <div class="project-name">Project Variyari</div>
    </nav>

    <!-- Main Content -->
    <main class="main-content">

        <%- include('../common/sidebar') %>
            <!-- Scrollable Content -->
            <!-- ... (Head and Navbar same as before) ... -->

            <div class="content-area">
                <div class="profile-container">
                    <div class="profile-header">
                        <!-- Dynamic Image Source -->
                    <% if(user.profile_pic_path != null) {%>
                        <img src='<%= user.profile_pic_path %>' alt="Profile" class="profile-pic-large">
                    <%}else {%>
                        <img src="/images/user_profile/default_user.webp" alt="Profile" class="profile-pic-large">
                    <% } %>
                        <h2>Edit Profile</h2>
                        <p style="color: #6b7280;">Update your personal information</p>
                    </div>

                    <form action="/dashboard/profile/update" method="POST" enctype="multipart/form-data">
                        <!-- First & Last Name -->
                        <div class="form-row">
                            <div class="form-group">
                                <label>First Name</label>
                                <input type="text" name="first_name" value="<%= user.first_name %>" required>
                            </div>
                            <div class="form-group">
                                <label>Last Name</label>
                                <input type="text" name="last_name" value="<%= user.last_name %>" required>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="email" name="email" value="<%= user.email_id %>" required>
                        </div>

                        <!-- Bio -->
                        <div class="form-group">
                            <label>Bio</label>
                            <textarea name="bio"
                                placeholder="Tell us about yourself..."><%= user.bio %></textarea>
                        </div>

                        <!-- Profile picture -->
                        <div class="form-group">
                            <label>Profile Picture</label>
                            <input type="file" name="profile_picture" id="profile-picture">
                        </div>

                        <!-- Buttons -->
                        <div class="button-group">
                            <a href="/dashboard/profile" class="btn-cancel">Cancel</a>
                            <button type="submit" class="btn-save">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
    </main>

</body>

</html>