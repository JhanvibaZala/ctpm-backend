<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <style>
        /* don't move this code to separate css file */
        /* sidebar activate  */
        .dash-active {
            background-color: #2062d5;
            color: white !important;
        }


        /* dashboard.css */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Inter, "Segoe UI", Arial, sans-serif;
            background: #f4f7fb;
            color: #1f2937;
        }

        .navbar {
            height: 70px;
            background: #2062d5;
            color: white;
            display: flex;
            align-items: center;
            padding: 0 32px;
            font-size: 1.4rem;
            font-weight: 600;
            box-shadow: 0 2px 12px rgba(0, 0, 0, .08);
        }

        .container {
            display: flex;
            min-height: calc(100vh - 70px);
        }

        .main-content {
            flex: 1;
            padding: 35px;
        }

        /* Workspace header */

        .main-content h1 {
            font-size: 2rem;
            margin-bottom: 10px;
            color: #111827;
        }

        .main-content>p:first-of-type {
            color: #6b7280;
            margin-bottom: 30px;
            font-size: 1rem;
        }

        /* Stats Card */

        .main-content>p:nth-of-type(2) {
            background: white;
            padding: 20px 24px;
            border-radius: 14px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, .08);
            margin-bottom: 30px;
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            font-weight: 500;
            color: #374151;
        }

        .main-content>p:nth-of-type(2) strong {
            color: #111827;
        }

        /* Charts */

        .chart-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
            gap: 28px;
        }

        .chart-card {
            background: white;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, .08);
            height: 600px;
        }

        .chart-card h2 {
            font-size: 1.2rem;
            margin-bottom: 20px;
            color: #1f2937;
        }

        .chart-card canvas {
            width: 100% !important;
            height: calc(100% - 50px) !important;
        }

        /* Small screens */

        @media (max-width: 768px) {
            .main-content {
                padding: 20px;
            }

            .chart-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <nav class="navbar">
        <div class="project-name">Project Variyari</div>
    </nav>
    <div class="container">
        <%- include("../common/sidebar") %>
            <main class="main-content">
                <h1>
                    <%=workspaceInfo['workspace_name']%>
                </h1>
                <p>
                    <%=workspaceInfo['description']%>
                </p>
                <p class="stats">
                    <%const total = Object.values(stats.status).reduce((sum, value) => sum + value, 0);%>
                    <span><strong>Total Projects:</strong> <%= total %></span>
                    <span><strong>WIP:</strong> <%= stats.status["WIP"] %></span>
                    <span><strong>On Hold:</strong> <%= stats.status["On Hold"] %></span>
                    <span><strong>Pending:</strong> <%= stats.status["Pending"] %></span>
                    <span><strong>Completed:</strong> <%= stats.status["Completed"] %></span>
                </p>

                <div class="chart-grid">
                    <div class="chart-card">
                        <h2>Project Status</h2>
                        <canvas id="statusChart"></canvas>
                    </div>

                    <div class="chart-card">
                        <h2>Priority Distribution</h2>
                        <canvas id="urgencyChart"></canvas>
                    </div>
                </div>
            </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const figures = <%- JSON.stringify(stats) %>;
        const statusLabels = Object.keys(figures.status);
        const statusCounts = Object.values(figures.status);

        new Chart(document.getElementById("statusChart"), {
            type: "pie",
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusCounts,
                    backgroundColor: [
                        "#3b82f6",
                        "#f59e0b",
                        "#10b981",
                        "#ef4444"
                    ]
                }]
            },
            options: {
                responsive: true
            }
        });

        new Chart(document.getElementById("urgencyChart"), {
            type: "bar",
            data: {
                labels: Object.keys(figures.urgency),
                datasets: [{
                    label: "Projects by Urgency",
                    data: Object.values(figures.urgency),
                    backgroundColor: [
                        "#10b981", // Low
                        "#3b82f6", // Medium
                        "#f59e0b", // High
                        "#ef4444"  // Urgent
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false, // 👈 IMPORTANT for custom height
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });
    </script>
</body>

</html>