<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password</title>
    <link rel="stylesheet" href="/css/forgotPassword.css" />

    <link rel="stylesheet" href="/css/auth-style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
  <body>
 
    <div class="main-container">
      <div class="main-wrapper flex-center">
        <div class="box-container">
          <div class="primary-box">
            <div class="title">
            <h1 class="pre-font" id="title-text">PROJECTCORE</h1>
            <h3 class="pre-font" id="title-desc-text">Collaborative Task & Project Management Tool</h3>
            </div>
            <div class="log-box-container ">
                <p class="pre-font" id="log-text">Reset Password Page</p>
                <p class="pre-font" id="log-desc-text" >Please enter a new password</p>
                <div class="log-box">
                    <form action="/reset-password" method="post" id="log-form">

                 
                        <label for="password" class="label-text">Password</label>
                        <div class="password-container">
                            <input type="password" name="password" id="password" required class="inp-field">
                            <span class="toggle-password" onclick="togglePassword('password', this)"><i class="fa-solid fa-eye"></i></span>
                        </div>
                        <br>
                        <br>
                        <label for="confirmPassword" class="label-text">Confirm Password</label>
                        <div class="password-container">
                            <input type="password" name="confirmPassword" id="confirmPassword" required class="inp-field">
                            <span class="toggle-password" onclick="togglePassword('confirmPassword', this)"><i class="fa-solid fa-eye"></i></span>
                        </div>
                        <input type="submit" value="RESET" name="" id="submit-btn">
                    </form>
                    <br>
                    <% if(typeof errors !== "undefined" && errors.length > 0) { %>
                         <div style="color: red; margin-bottom: 15px;">
                            <span>
                                <%= errors[0].message %>
                            </span>
                        </div>
                    <% } %>
                </div>
            </div>
            
          </div>
          <div class="cover-box">
            <img src="/images/cover_img.jpg" id="cover-img" alt="">
          </div>
        </div>
          
      </div>
    </div>
  </body>
</html>
<script src="/js/passwordToggle.js"></script>