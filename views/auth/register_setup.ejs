<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Workspace Portal</title>
    <link rel="stylesheet" href="/css/register_setup.css">
    <link rel="stylesheet" href="/css/auth-style.css" />
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="project-name">Project Variyari</div>
    </nav>

    <!-- Main Split Section -->
    <div class="main-container">
        
        <!-- Left Side: Options -->
        <div class="left-panel">
            <div class="options-container">
                <h2>Get Started</h2>
                
                <!-- Create Workspace -->
                <button class="btn btn-primary">Create New Workspace</button>
                
                <div class="divider"><span>OR</span></div>
                
                <!-- Join Workspace -->
                <div class="input-group">
                    <label for="invite-code">Invitation Code</label>
                    <input type="text" id="invite-code" placeholder="Enter code (e.g., XYZ-123)">
                </div>
                <button class="btn btn-secondary">Join Workspace</button>
            </div>
        </div>

        <!-- Right Side: Image -->
        <div class="right-panel">
            <!-- Replace src with your actual image URL -->
            <img src="/images/cover_img.jpg" alt="Team collaboration workspace">
        </div>

    </div>

</body>
</html>   