<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password</title>
    <link rel="stylesheet" href="/css/forgotPassword.css" />
      <link rel="stylesheet" href="/css/auth-style.css" />

</head>

<body>

    <div class="main-container">
        <div class="main-wrapper flex-center">
            <div class="box-container">
                <div class="primary-box">
                    <div class="title">
                        <h1 class="pre-font" id="title-text">PROJECTCORE</h1>
                        <h3 class="pre-font" id="title-desc-text">Collaborative Task & Project Management Tool</h3>
                    </div>
                    <div class="log-box-container ">
                        <p class="pre-font" id="log-text">Forgot Password Page</p>
                        <p class="pre-font" id="log-desc-text">Please enter your email or username for otp</p>
                        <div class="log-box">
                            <form method="post" id="forgot-form">


                                <label for="email" class="label-text">Email Address / Username</label>

                                <input type="text" name="email" id="email" required class="inp-field">
                                <input type="submit" value="SEND OTP" name="" id="submit-btn">
                            </form>
                            <br>
                            <div style="color: red; margin-bottom: 15px; padding: 10px;">

                                <p id="errMsg2"></p>
                            </div>

                            <% if (typeof error !=='undefined' && error) { %>
                                <div style="color: red; margin-bottom: 15px; padding: 10px;">
                                    <%= error %>
                                </div>
                                <% } %>
                            

                        </div>
                    </div>

                </div>
                <div class="cover-box">
                    <img src="/images/cover_img.jpg" id="cover-img" alt="">
                </div>
            </div>

        </div>
    </div>
</body>

</html>


<script>
  const form = document.getElementById("forgot-form");
  let errMsg = document.getElementById("errMsg2");

  form.addEventListener("submit", async (e) => {
    e.preventDefault(); 

    const email = document.getElementById("email").value.trim(); // ✅ trim whitespace too
    console.log(email);

    if (email === "" || email.length < 3) {
      errMsg.textContent = "Invalid email or username";
      return;
    }

    try {
      const resp = await fetch("/forgot-password", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ email }),
      });

      if (!resp.ok) {
        const errorData = await resp.json();
        errMsg.textContent = errorData.message || "Something went wrong. Please try again."; // ✅ extract string from object
        return;
      }

      const responseData = await resp.json();
      const otp = responseData.data.otp;
      console.log(otp);

      window.open(`/gmail/${otp}`, "_blank");
      window.location.href = "/otp";

    } catch (err) {
      errMsg.textContent = "Network error. Please try again."; // ✅ handles fetch failures
      console.error(err);
    }
  });



</script>